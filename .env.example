# ==============================================================================
# Bus Route Identifier - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` in this directory:
#   cp .env.example .env
# Never commit `.env` or service account keys to version control.
# ==============================================================================

# OCR Mode: "auto" | "offline" | "online"
# - "auto"   : Runs offline engine (RapidOCR / Tesseract) first; if no route or
#              confidence < threshold, falls back to Google Cloud Vision.
# - "offline": Strictly offline engine only (no internet calls). Default on Pi/local.
# - "online" : Strictly Google Cloud Vision only. Default on Vercel serverless.
OCR_MODE=auto

# Online OCR Timeout (seconds)
ONLINE_TIMEOUT_S=3.0

# Google Cloud Vision API Key (Recommended for REST API)
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Enable "Cloud Vision API" on your project.
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Alternative: Path to Google Cloud Service Account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Offline OCR Engine (when running offline): "paddleocr" | "tesseract" | "easyocr"
OCR_ENGINE=paddleocr
